  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "String"
        },
        "isEmailVerified": {
          "type": "string",
          "example": "Boolean"
        },
        "createdAt": {
          "type": "string",
          "example": "Date"
        },
        "updatedAt": {
          "type": "string",
          "example": "Date"
        }
      }
    },
    "RegisterRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "user@example.com"
        },
        "password": {
          "type": "string",
          "example": "securepassword"
        }
      }
    },
    "SuccessResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "200/201"
        },
        "data": {
          "type": "string",
          "example": "{}"
        },
        "message": {
          "type": "string",
          "example": "Success!"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "400/401/403/500"
        },
        "data": {
          "type": "string",
          "example": "null"
        },
        "success": {
          "type": "boolean",
          "example": false
        },
        "errors": {
          "type": "array",
          "example": [],
          "items": {}
        },
        "isOperational": {
          "type": "boolean",
          "example": true
        },
        "message": {
          "type": "string",
          "example": "Message about the error"
        }
      }
    }
  },
  "components": {
    "securitySchemas": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "UnAuthorizedError": {
        "status": "401",
        "data": "null",
        "success": false,
        "errors": [],
        "isOperational": true,
        "message": "UnAuthorized, You are not authorized"
      },
      "BadRequest": {
        "status": "400",
        "data": "null",
        "success": false,
        "errors": [],
        "isOperational": true,
        "message": "Bad Request"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
